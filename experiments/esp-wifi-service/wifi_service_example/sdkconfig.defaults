CONFIG_ESP_MCP_ENABLE=n
CONFIG_WIFI_SERVICE_MCP_ENABLE=n

# Synced from wifi_demo defaults
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_RSA=y
CONFIG_MBEDTLS_DHM_C=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096


# JrBot laboratory: HTTP provisioning only
CONFIG_WIFI_SERVICE_PROV_HTTP_ENABLE=y
CONFIG_WIFI_SERVICE_PROV_HTTP_DEFAULT_WEBUI_ENABLE=y
CONFIG_WIFI_SERVICE_PROV_BLUFI_ENABLE=n
