menu "JrBot V2 - hardware"
    config JR_HEADLESS_DIAGNOSTIC
        bool "Run without OLED (no I2C access to GPIO1/2)"
        default y
        help
            Keep the panel, command terminal and Wi-Fi independent of the OLED.
            No amplifier, camera, microphone or servo test runs at boot.

    config JR_AUDIO_BCLK_GPIO
        int "Amplifier BCLK GPIO (-1 = not assigned)"
        range -1 48
        default -1
    config JR_AUDIO_WS_GPIO
        int "Amplifier WS/LRC GPIO (-1 = not assigned)"
        range -1 48
        default -1
    config JR_AUDIO_DOUT_GPIO
        int "ESP32 DOUT to amplifier DIN GPIO (-1 = not assigned)"
        range -1 48
        default -1
    config JR_AUDIO_HW03_CONFIRMED
        bool "HW03: I verified all three audio wires and board availability"
        depends on JR_AUDIO_BCLK_GPIO >= 0 && JR_AUDIO_WS_GPIO >= 0 && JR_AUDIO_DOUT_GPIO >= 0
        default n
        help
            GPIO21, GPIO41, GPIO42 and GPIO47 are already occupied by the owner.
            Never reuse them. Camera/OLED/USB/UART/memory/boot pins stay reserved.
            Check hardware/pinmap.json and docs/ESQUEMA_LIGACAO.md.
            Previous JR_AUDIO_PINS_CONFIRMED settings do not enable this revision.
            This enables an on-demand test in the panel, not automatic playback.

    config JR_CAMERA_PINS_CONFIRMED
        bool "Allow one-shot camera test after verifying the existing camera pinout"
        default n
        help
            Verify the integrated camera connector against docs/PINAGEM.md.
            No autofocus, no servo movement; one QVGA/JPEG frame then cleanup.
endmenu
