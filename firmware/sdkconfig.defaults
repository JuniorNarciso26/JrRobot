# ESP32-S3 / memory setup used in the reported boot; PCB revision still to identify.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_OV5640_SUPPORT=y
CONFIG_CAMERA_AF_SUPPORT=y
CONFIG_CAMERA_AF_DEFAULT_TIMEOUT_MS=3000
# CONFIG_CAMERA_PSRAM_DMA is not set
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=262144
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_JR_HEADLESS_DIAGNOSTIC=y
# CONFIG_JR_CAMERA_PINS_CONFIRMED is not set
# HW03: do NOT inherit any previous physical audio approval.
CONFIG_JR_AUDIO_BCLK_GPIO=-1
CONFIG_JR_AUDIO_WS_GPIO=-1
CONFIG_JR_AUDIO_DOUT_GPIO=-1
# CONFIG_JR_AUDIO_HW03_CONFIRMED is not set
